# Set your actual canonical domain before production deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional contact delivery: Resend API key + a sender on your verified domain.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Generate with: openssl rand -hex 32. Vercel passes this as a Bearer token.
CRON_SECRET=
# Optional authorized private feed token, referenced by tokenEnv in event-sources.json.
EVENTS_FEED_TOKEN=
# Stage 1: camera operations (all secret values are server-only)
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
OWNER_EMAILS=aslansaid69@gmail.com
# Additional trusted camera/CDN hosts. ipcam.kz is built in. No wildcard hosts.
CAMERA_ALLOWED_HOSTS=
# QStash: set these to activate the 15-minute monitor on Vercel Hobby.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Stage 2: weather. Evaluation is for prototypes; commercial operation needs a paid key.
WEATHER_MODE=evaluation
OPEN_METEO_API_KEY=
# Automatic owner failure alerts through Resend (separate from mailto contact form).
ALERT_FROM=
ALERT_TO=aslansaid69@gmail.com
# RESEND_API_KEY is defined above. Use a sender domain verified in Resend.
