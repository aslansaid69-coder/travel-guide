# Set your actual canonical domain before production deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional contact delivery: Resend API key + a sender on your verified domain.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Generate with: openssl rand -hex 32. Vercel passes this as a Bearer token.
CRON_SECRET=
# Optional authorized private feed token, referenced by tokenEnv in event-sources.json.
EVENTS_FEED_TOKEN=
# Stage 1: camera operations (all secret values are server-only)
DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
OWNER_EMAILS=aslansaid69@gmail.com
# Additional trusted camera/CDN hosts. ipcam.kz is built in. No wildcard hosts.
CAMERA_ALLOWED_HOSTS=
# QStash: set these to activate the 15-minute monitor on Vercel Hobby.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Stage 2: weather. Evaluation is for prototypes; commercial operation needs a paid key.
WEATHER_MODE=evaluation
OPEN_METEO_API_KEY=
# Automatic owner failure alerts through Resend (separate from mailto contact form).
ALERT_FROM=
ALERT_TO=aslansaid69@gmail.com
# RESEND_API_KEY is defined above. Use a sender domain verified in Resend.
# Travel hub: optional integrations. All keys are server-only.
GOOGLE_PLACES_API_KEY=
# Optional OSM Overpass endpoint. Leave empty for bounded public-instance fallback.
OVERPASS_ENDPOINT=
# Road routes; without this key routes/travel times are labelled estimates.
ORS_API_KEY=
# Stripe business account must be eligible for your legal business location.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional post-payment invoice PDFs: provider fees apply; configure legal details first.
STRIPE_INVOICE_ENABLED=false
# Optional permitted image/PDF menu parser (OpenAI-compatible chat endpoint).
MENU_AI_URL=
MENU_AI_KEY=
MENU_AI_MODEL=
# Optional translation drafts (same compatible endpoint contract).
TRANSLATION_AI_URL=
TRANSLATION_AI_KEY=
TRANSLATION_AI_MODEL=
# Optional staff Telegram and transactional SMS. User consent is required for SMS.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Platform v2: optional independent web search and bounded official price sources.
TAVILY_API_KEY=
RESEARCH_ALLOWED_HOSTS=
# Optional OpenAI-compatible travel assistant / translation. Keys never reach the browser.
TRAVEL_AI_URL=
TRAVEL_AI_KEY=
TRAVEL_AI_MODEL=
# Connect is OFF until the operator verifies actual country eligibility with Stripe.
STRIPE_CONNECT_ENABLED=false
STRIPE_PLATFORM_COUNTRY=
STRIPE_CONNECT_COUNTRIES=
# Client bot pairing. Set a secret_token when registering Telegram's webhook.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# Meta WhatsApp Cloud API: authenticated inbound webhook + approved outbound template.
WHATSAPP_PHONE_NUMBER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Private photos are stored in the existing DB with a global upload allowance.
PRIVATE_GALLERY_LIMIT_MB=250
# --- Upgrade (Nov 2026) ---
# Direct (non-pooled) Neon URL for migrations; falls back to DATABASE_URL without "-pooler".
DATABASE_URL_UNPOOLED=
# Claude (server-only). Powers the assistant and "Generate description". Model override optional.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Places import: google | opentripmap | wikipedia (default: first configured, Wikipedia needs no key).
PLACES_PROVIDER=
OPENTRIPMAP_API_KEY=
