{
  "name": "almaty-travel-guide",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "events:refresh": "node --import tsx scripts/refresh-events.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "schedules:configure": "node --env-file=.env.local --import tsx scripts/configure-schedules.ts",
    "test:updates:integration": "node --env-file=.env.stage2-test --import tsx scripts/test-updates-integration.ts",
    "test:hub:integration": "node --env-file=.env.stage2-test --import tsx scripts/test-hub-integration.ts",
    "test:platform:integration": "node --env-file=.env.platform-test --import tsx scripts/test-platform-integration.ts",
    "test:platform:http": "node --env-file=.env.platform-test --import tsx scripts/test-platform-http.ts",
    "lint": "eslint .",
    "db:migrate:status": "node --env-file=.env.local --import tsx scripts/migrate.ts --dry-run",
    "db:migrate:prod": "node --import tsx scripts/migrate.ts",
    "test:local-db": "node --conditions=react-server --import tsx --test tests/integration/*.itest.ts",
    "vercel-build": "node --import tsx scripts/predeploy.ts && next build --webpack"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@fontsource/dm-serif-display": "^5.2.5",
    "@fontsource/inter": "^5.2.5",
    "@neon/auth": "^0.8.2",
    "@neondatabase/serverless": "^1.2.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@upstash/qstash": "^2.12.2",
    "fast-xml-parser": "5.12.1",
    "hls.js": "1.7.4",
    "jose": "^6.2.17",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.468.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@tailwindcss/postcss": "4.3.5",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "^8.23.1",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": "22.x"
  },
  "type": "module"
}
